// SYNTAX TEST "source.promise"

test_lambdas() {
// --- Lambda with params ---
  f := |int x| -> x * 2;
//      ^^^ support.type.primitive.promise
//          ^ variable.parameter.promise

// --- Lambda with block body ---
  g := |int x, int y| -> int {
//      ^^^ support.type.primitive.promise
//          ^ variable.parameter.promise
//             ^^^ support.type.primitive.promise
//                 ^ variable.parameter.promise
    return x + y;
  };

// --- Move lambda with empty params ---
  h := move || -> 42;
//     ^^^^ keyword.other.move.promise
//          ^^ punctuation.definition.lambda.promise

// --- Move lambda with params ---
  k := move |int x| -> x;
//     ^^^^ keyword.other.move.promise
//               ^ variable.parameter.promise

// --- Lambda with a block body ---
  m := |int x| { return x; };
//      ^^^ support.type.primitive.promise
//          ^ variable.parameter.promise

// --- A lambda still parses on a line that also contains a bitwise OR ---
  n := |int x| -> x | 1;
//      ^^^ support.type.primitive.promise
//          ^ variable.parameter.promise
//                  ^ keyword.operator.bitwise.promise
  return n;
//^^^^^^ keyword.control.promise
}
